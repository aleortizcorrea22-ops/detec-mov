# Copia este archivo como .env y completa los datos.

# Token del bot que te da @BotFather en Telegram (ej. 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Chat(s) que reciben las alertas. Varios separados por coma.
# Para obtenerlo: escríbele "hola" a tu bot y usa el botón "Buscar mi chat_id" de la app.
TELEGRAM_CHAT_ID=

# Puerto del servidor
PORT=3000

# HTTPS opcional (para usar la cámara del celular sin túnel). Rutas a certificado y clave.
# HTTPS_CERT=./certs/cert.pem
# HTTPS_KEY=./certs/key.pem

# Por seguridad el proxy de cámaras solo acepta IPs de la red local. Pon 1 para permitir cualquiera.
# ALLOW_PUBLIC_CAMERAS=0
